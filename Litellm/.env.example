# ==============================================================================
# LiteLLM Environment Variables & Provider Keys
# ==============================================================================

# Master key to authenticate with the LiteLLM proxy (auto-generated during ./setup.sh)
LITELLM_MASTER_KEY=

# Cryptographic salt for token hashing (auto-generated during ./setup.sh)
LITELLM_SALT_KEY=

# Internal database password
LITELLM_DB_PASSWORD=litellm

# Port for LiteLLM proxy
LITELLM_PORT=4000

# Granite Embedding Service Port
GRANITE_PORT=8080

# ------------------------------------------------------------------------------
# POST-SETUP: Add your Upstream LLM Provider API Keys below
# ------------------------------------------------------------------------------
# OpenRouter API Key (required if routing via OpenRouter models)
OPENROUTER_API_KEY=

# Direct OpenAI API Key (optional)
# OPENAI_API_KEY=

# Direct Anthropic API Key (optional)
# ANTHROPIC_API_KEY=

# Direct Google Gemini API Key (optional)
# GEMINI_API_KEY=
