# ==============================================================================
# LibreChat Server Configuration
# ==============================================================================

# Server Network Settings
HOST=0.0.0.0
PORT=3080

# Domain configuration (Set to your org server IP or domain in production)
DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080

# ------------------------------------------------------------------------------
# Security & Cryptographic Secrets (Auto-generated by ./setup.sh)
# ------------------------------------------------------------------------------
JWT_SECRET=
JWT_REFRESH_SECRET=
CREDS_KEY=
CREDS_IV=
MEILI_MASTER_KEY=
ADMIN_PANEL_SESSION_SECRET=

# Admin Panel Configuration
ADMIN_PANEL_PORT=3000
ADMIN_PANEL_URL=http://localhost:3000
ADMIN_PANEL_SESSION_COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# Upstream LiteLLM Proxy Integration (Auto-configured by ./setup.sh)
# ------------------------------------------------------------------------------
LITELLM_API_KEY=

# ------------------------------------------------------------------------------
# Local Vector RAG & IBM Granite Embeddings Integration
# ------------------------------------------------------------------------------
RAG_PORT=8000
RAG_API_URL=http://rag_api:8000
RAG_OPENAI_BASEURL=http://litellm_api:4000/v1
RAG_OPENAI_API_KEY=
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=granite-embedding-125m

# Web Search Provider (SearXNG)
SEARCH=false

# Registration Policy (Set to false after creating the initial admin account)
ALLOW_REGISTRATION=true
ALLOW_EMAIL_LOGIN=true
ALLOW_PASSWORD_RESET=false
ALLOW_UNVERIFIED_EMAIL_LOGIN=true
